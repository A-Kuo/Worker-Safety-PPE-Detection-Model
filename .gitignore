# Raw / downloaded datasets — do not commit 44k images
data/raw/
data/processed/
data/combined/
data/hardhat/
data/construction/

# Kaggle/Colab working-dir dumps (multi-GB, and they contain a full nested .git) - never commit
*.zip
_output_/
_output_*/

# Ultralytics / experiment runs
runs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — never commit API keys
.env
.env.*
!.env.example

# Virtualenvs
.venv/
.venv-npu/
venv/
env/

# Model weights are release assets, never committed
*.pt

# Exported / quantized ONNX binaries (keep models/README.md)
models/*.onnx
*.onnx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Rust build output (experimental native port); the crate has no dependencies, so no lockfile
native/**/target/
native/**/Cargo.lock
